# 联机后端运行参数（复制为 .env 后按实际填写；systemd 用 EnvironmentFile 读取）
#
# 回合操作时限（秒）。轮到的人超时不动，系统按 AI 代打一步。
TURN_TIMEOUT_SECONDS=40
# 调试通道总开关（客户端 DEV 面板的 debug-end / debug-money）。生产测完建议关掉。
TOY_DEBUG=1
# 调试密码：每条 debug 消息都要带上它，服务端校验；不设 = 调试通道保持禁用。
TOY_DEBUG_PASSWORD=change-me

# BIND：监听地址。生产填 127.0.0.1（只让本机反代进来）；
# 留空默认 0.0.0.0，仅适合局域网联调，公网机器别这么开。
BIND=127.0.0.1

# PORT：监听端口，默认 8080；生产用 8091（8080 被 clouderyapi 容器占用）。
PORT=8091

# TOY_API_BASE：ClouderyApi 根地址。留空则退化成「房间号模式」——能开房、能对局、能重连，
# 但没有大厅列表与快速匹配。生产填 https://api.cloudery.cn
TOY_API_BASE=https://api.cloudery.cn

# TOY_SERVER_KEY：服务端共享密钥，必须与 ClouderyApi 的 Toy:ServerKey 完全一致。
# 它只出现在这一行，不要提交进仓库、不要写进前端。
TOY_SERVER_KEY=

# ALLOWED_ORIGINS：允许连 WebSocket 的页面来源，逗号分隔。
# Toy 的页面实际资源域是 www.bilibilitoy.com，外面还套一层 www.bilibili.com 的壳，
# 两个都写上最稳；无 Origin 的连接（脚本 / 探针）不受此限制。
ALLOWED_ORIGINS=https://www.bilibilitoy.com,https://www.bilibili.com
